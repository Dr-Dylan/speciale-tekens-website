<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Speciale Tekens</title>

<style>
    :root {
        --bg: #f5f5f7;
        --card: rgba(255,255,255,0.85);
        --text: #1d1d1f;
        --secondary: #6e6e73;
        --border: rgba(0,0,0,0.08);
        --blue: #007aff;
        --blue-light: #e8f2ff;
        --shadow: 0 8px 30px rgba(0,0,0,0.08);
    }

    body.dark {
        --bg: #101012;
        --card: rgba(30,30,32,0.9);
        --text: #f5f5f7;
        --secondary: #a1a1a6;
        --border: rgba(255,255,255,0.1);
        --blue: #0a84ff;
        --blue-light: #15263d;
        --shadow: 0 8px 30px rgba(0,0,0,0.35);
    }

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family:
            -apple-system,
            BlinkMacSystemFont,
            "SF Pro Display",
            "Segoe UI",
            sans-serif;
        transition: background 0.3s, color 0.3s;
    }

    header {
        padding: 55px 20px 35px;
        text-align: center;
        background:
            radial-gradient(circle at 50% 0%, rgba(0,122,255,0.18), transparent 45%);
    }

    .logo {
        font-size: 55px;
        margin-bottom: 8px;
    }

    h1 {
        font-size: clamp(32px, 6vw, 55px);
        margin: 0;
        letter-spacing: -2px;
    }

    .subtitle {
        color: var(--secondary);
        font-size: 17px;
        margin-top: 10px;
    }

    .topbar {
        max-width: 1050px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .search-container {
        position: relative;
        margin: 5px auto 18px;
    }

    .search {
        width: 100%;
        padding: 17px 52px 17px 52px;
        border-radius: 18px;
        border: 1px solid var(--border);
        background: var(--card);
        color: var(--text);
        font-size: 17px;
        outline: none;
        box-shadow: var(--shadow);
        backdrop-filter: blur(15px);
    }

    .search:focus {
        border-color: var(--blue);
        box-shadow: 0 0 0 4px rgba(0,122,255,0.12);
    }

    .search-icon {
        position: absolute;
        left: 18px;
        top: 14px;
        font-size: 23px;
    }

    .shortcut {
        position: absolute;
        right: 14px;
        top: 12px;
        padding: 6px 9px;
        border-radius: 7px;
        background: var(--blue-light);
        color: var(--blue);
        font-size: 12px;
    }

    .controls {
        display: flex;
        gap: 10px;
        align-items: center;
        margin-bottom: 20px;
    }

    .categories {
        display: flex;
        gap: 8px;
        overflow-x: auto;
        flex: 1;
        scrollbar-width: none;
    }

    .categories::-webkit-scrollbar {
        display: none;
    }

    .category {
        white-space: nowrap;
        border: 1px solid var(--border);
        background: var(--card);
        color: var(--text);
        padding: 10px 16px;
        border-radius: 20px;
        cursor: pointer;
        font-size: 14px;
        transition: 0.2s;
    }

    .category:hover {
        transform: translateY(-1px);
    }

    .category.active {
        background: var(--blue);
        color: white;
        border-color: var(--blue);
    }

    .theme-button {
        flex-shrink: 0;
        width: 42px;
        height: 42px;
        border: 1px solid var(--border);
        background: var(--card);
        color: var(--text);
        border-radius: 50%;
        cursor: pointer;
        font-size: 18px;
    }

    .stats {
        color: var(--secondary);
        font-size: 14px;
        margin: 5px 0 18px;
    }

    #results {
        max-width: 1050px;
        margin: 0 auto;
        padding: 0 20px 60px;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 16px;
    }

    .card {
        position: relative;
        overflow: hidden;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 22px;
        padding: 20px;
        box-shadow: var(--shadow);
        backdrop-filter: blur(15px);
        transition:
            transform 0.2s,
            box-shadow 0.2s;
    }

    .card:hover {
        transform: translateY(-4px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.12);
    }

    .card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .symbol {
        font-size: 58px;
        height: 75px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .category-label {
        font-size: 11px;
        color: var(--blue);
        background: var(--blue-light);
        padding: 5px 8px;
        border-radius: 7px;
        font-weight: 600;
    }

    .name {
        font-size: 18px;
        font-weight: 650;
        margin-top: 12px;
    }

    .description {
        color: var(--secondary);
        font-size: 13px;
        margin-top: 5px;
        min-height: 32px;
    }

    .typing-box {
        margin-top: 16px;
        padding: 12px;
        border-radius: 13px;
        background: var(--blue-light);
    }

    .typing-title {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--blue);
        font-weight: 700;
        margin-bottom: 5px;
    }

    .typing {
        font-size: 14px;
        line-height: 1.45;
        font-weight: 500;
    }

    .alternative {
        margin-top: 9px;
        font-size: 11px;
        color: var(--secondary);
    }

    .empty {
        grid-column: 1 / -1;
        text-align: center;
        padding: 70px 20px;
        color: var(--secondary);
    }

    .empty-icon {
        font-size: 55px;
        margin-bottom: 10px;
    }

    footer {
        text-align: center;
        color: var(--secondary);
        padding: 20px;
        font-size: 13px;
    }

    @media (max-width: 600px) {
        header {
            padding-top: 35px;
        }

        .shortcut {
            display: none;
        }

        #results {
            grid-template-columns: 1fr;
        }
    }
</style>
</head>

<body>

<header>
    <div class="logo">✨</div>
    <h1>Speciale Tekens</h1>
    <div class="subtitle">
        Een woordenboek voor tekens die je niet zomaar op je toetsenbord vindt.
    </div>
</header>

<div class="topbar">

    <div class="search-container">
        <span class="search-icon">⌕</span>

        <input
            id="search"
            class="search"
            type="text"
            placeholder="Zoek bijvoorbeeld: u met puntjes, euro, pijl..."
            autocomplete="off"
        >

        <span class="shortcut">⌘ K</span>
    </div>

    <div class="controls">

        <div class="categories">

            <button class="category active"
                onclick="filterCategory('Alles', this)">
                Alles
            </button>

            <button class="category"
                onclick="filterCategory('Letters', this)">
                🔤 Letters
            </button>

            <button class="category"
                onclick="filterCategory('Symbolen', this)">
                ⭐ Symbolen
            </button>

            <button class="category"
                onclick="filterCategory('Pijlen', this)">
                ➡️ Pijlen
            </button>

            <button class="category"
                onclick="filterCategory('Wiskunde', this)">
                ∑ Wiskunde
            </button>

            <button class="category"
                onclick="filterCategory('Valuta', this)">
                💰 Valuta
            </button>

            <button class="category"
                onclick="filterCategory('Muziek', this)">
                🎵 Muziek
            </button>

            <button class="category"
                onclick="filterCategory('Kaarten', this)">
                🃏 Kaarten
            </button>

            <button class="category"
                onclick="filterCategory('Schaken', this)">
                ♟️ Schaken
