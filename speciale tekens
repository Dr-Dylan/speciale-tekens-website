        </div>

        <button class="theme-button" onclick="toggleDarkMode()" id="theme">
            🌙
        </button>

    </div>

    <div class="stats" id="stats"></div>

</div>

<div id="results"></div>

<footer>
    Speciale Tekens Woordenboek • Gemaakt voor Mac 💻
</footer>

