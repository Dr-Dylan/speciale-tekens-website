let huidigeCategorie = "Alles";

function toonTekens() {

    const zoekterm =
        document.getElementById("search").value.toLowerCase().trim();

    const resultaten = tekens.filter(item => {

        const tekst =
            (item.name + " " +
             item.description + " " +
             item.char + " " +
             item.typing).toLowerCase();

        const zoekMatch = tekst.includes(zoekterm);

        const categorieMatch =
            huidigeCategorie === "Alles" ||
            item.category === huidigeCategorie;

        return zoekMatch && categorieMatch;
    });

    const container = document.getElementById("results");

    container.innerHTML = "";

    document.getElementById("stats").textContent =
        `${resultaten.length} van ${tekens.length} tekens`;

    if (resultaten.length === 0) {

        container.innerHTML = `
            <div class="empty">
                <div class="empty-icon">🔍</div>
                <h2>Niets gevonden</h2>
                <p>Probeer een andere zoekterm.</p>
            </div>
        `;

        return;
    }

    resultaten.forEach(item => {

        const card = document.createElement("article");

        card.className = "card";

        card.innerHTML = `

            <div class="card-top">

                <div class="symbol">
                    ${item.char}
                </div>

                <div class="category-label">
                    ${item.category}
                </div>

            </div>

            <div class="name">
                ${item.name}
            </div>

            <div class="description">
                ${item.description}
            </div>

            <div class="typing-box">

                <div class="typing-title">
                    ⌨️ Zo typ je het op Mac
                </div>

                <div class="typing">
                    ${item.typing}
                </div>

            </div>

        `;

        container.appendChild(card);
    });
}

function filterCategory(category, button) {

    huidigeCategorie = category;

    document
        .querySelectorAll(".category")
        .forEach(btn => btn.classList.remove("active"));

    button.classList.add("active");

    toonTekens();
}

function toggleDarkMode() {

    document.body.classList.toggle("dark");

    const dark =
        document.body.classList.contains("dark");

    document.getElementById("theme").textContent =
        dark ? "☀️" : "🌙";

    localStorage.setItem("darkMode", dark);
}

/* Dark mode onthouden */

if (localStorage.getItem("darkMode") === "true") {
    document.body.classList.add("dark");
    document.getElementById("theme").textContent = "☀️";
}

/* Zoekfunctie */

document
    .getElementById("search")
    .addEventListener("input", toonTekens);

/* ⌘ K = zoekbalk openen */

document.addEventListener("keydown", function(event) {

    if ((event.metaKey || event.ctrlKey) &&
        event.key.toLowerCase() === "k") {

        event.preventDefault();

        document.getElementById("search").focus();
    }

    if (event.key === "Escape") {

        document.getElementById("search").value = "";

        document.getElementById("search").blur();

        toonTekens();
    }
});

/* Start */

toonTekens();

